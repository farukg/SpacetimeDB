{
  "private": true,
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.16.0"
  },
  "type": "module",
  "scripts": {
    "run-all": "pnpm -r -F ./crates/bindings-typescript -F ./crates/bindings-typescript/test-app -F ./docs -F \"./templates/**\" -F \"./modules/spacetime-*-ts/**\" run",
    "format": "pnpm run-all format && prettier eslint.config.js --write",
    "lint": "pnpm run-all lint && prettier eslint.config.js --check",
    "build": "pnpm run-all build",
    "test": "pnpm run-all test",
    "generate": "pnpm run-all generate",
    "clean": "pnpm -r exec rimraf dist .tsbuildinfo coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^61.7.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
