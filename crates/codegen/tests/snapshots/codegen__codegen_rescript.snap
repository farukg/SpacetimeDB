// Typed reducer/procedure records — compile-time safety layer.
// If a reducer or procedure is removed from the server module and codegen
// is re-run, any call site referencing the missing field fails to compile.
//
// This file is a leaf dependency: reducer/procedure modules never import it.
// Consumer code uses `Api.reducers` / `Api.procedures` for typed access.

type reducers = {
  @as("add") add: Stdb__Reducers__Add.args => promise<unit>,

  @as("addPlayer") addPlayer: Stdb__Reducers__AddPlayer.args => promise<unit>,

  @as("addPrivate") addPrivate: Stdb__Reducers__AddPrivate.args => promise<unit>,

  @as("assertCallerIdentityIsModuleIdentity") assertCallerIdentityIsModuleIdentity: unit => promise<unit>,

  @as("deletePlayer") deletePlayer: Stdb__Reducers__DeletePlayer.args => promise<unit>,

  @as("deletePlayersByName") deletePlayersByName: Stdb__Reducers__DeletePlayersByName.args => promise<unit>,

  @as("listOverAge") listOverAge: Stdb__Reducers__ListOverAge.args => promise<unit>,

  @as("logModuleIdentity") logModuleIdentity: unit => promise<unit>,

  @as("queryPrivate") queryPrivate: unit => promise<unit>,

  @as("sayHello") sayHello: unit => promise<unit>,

  @as("test") test: Stdb__Reducers__Test.args => promise<unit>,

  @as("testBtreeIndexArgs") testBtreeIndexArgs: unit => promise<unit>,

}

type procedures = {
  @as("getMySchemaViaHttp") getMySchemaViaHttp: unit => promise<Stdb__Procedures__GetMySchemaViaHttp.response>,

  @as("returnValue") returnValue: Stdb__Procedures__ReturnValue.params => promise<Stdb__Procedures__ReturnValue.response>,

  @as("sleepOneSecond") sleepOneSecond: unit => promise<Stdb__Procedures__SleepOneSecond.response>,

  @as("withTx") withTx: unit => promise<Stdb__Procedures__WithTx.response>,

}

@get external reducers: Stdb__Sdk.connection => reducers = "reducers"
@get external procedures: Stdb__Sdk.connection => procedures = "procedures"
