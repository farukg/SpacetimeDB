"Stdb__Tables__LoggedOutPlayer.res" = '''
// THIS FILE IS AUTOMATICALLY GENERATED. EDITS TO THIS FILE
// WILL NOT BE SAVED. MODIFY THE SOURCE CONFIGURATION INSTEAD.


module Sdk = Stdb__Sdk
module Types = Stdb__Types
module Display = Stdb__Display
module Async = Stdb__Async
module React = Stdb__React

type t = {
  @as("identity") identity: Sdk.identity,

  @as("player_id") playerId: bigint,

  @as("name") name: string,

}
// Opaque table handle — obtained from Client.db
type handle

@send external iter: handle => Iterator.t<t> = "iter"

@send external onInsert: (handle, (Sdk.eventCtx, t) => unit) => unit = "onInsert"
@send external removeOnInsert: (handle, (Sdk.eventCtx, t) => unit) => unit = "removeOnInsert"
@send external onUpdate: (handle, (Sdk.eventCtx, t, t) => unit) => unit = "onUpdate"
@send external removeOnUpdate: (handle, (Sdk.eventCtx, t, t) => unit) => unit = "removeOnUpdate"
@send external onDelete: (handle, (Sdk.eventCtx, t) => unit) => unit = "onDelete"
@send external removeOnDelete: (handle, (Sdk.eventCtx, t) => unit) => unit = "removeOnDelete"

// PK index
type identityIndex
@get external identity: handle => identityIndex = "identity"
@send external find: (identityIndex, Sdk.identity) => Nullable.t<t> = "find"

let findById = (handle: handle, pkValue: Sdk.identity) =>
  handle->identity->find(pkValue)->Nullable.toOption

let tableName = "logged_out_player"

// ── Typed event union ─────────────────────────────────────────────────────────
type event =
  | Inserted({row: t})
  | Updated({prev: t, next: t})
  | Deleted({row: t})

let subscribe = (handle: handle, handler: event => unit): (unit => unit) => {
  let insertCb = (_ctx: Sdk.eventCtx, row: t) => handler(Inserted({row: row}))
  let updateCb = (_ctx: Sdk.eventCtx, prev: t, next: t) => handler(Updated({prev: prev, next: next}))
  let deleteCb = (_ctx: Sdk.eventCtx, row: t) => handler(Deleted({row: row}))
  handle->onInsert(insertCb)
  handle->onUpdate(updateCb)
  handle->onDelete(deleteCb)
  () => {
    handle->removeOnInsert(insertCb)
    handle->removeOnUpdate(updateCb)
    handle->removeOnDelete(deleteCb)
  }
}


// ── Observer mode ─────────────────────────────────────────────────────────────
module MakeStream = (O: Async.OBSERVER) => {
  let observe = (handle: handle): O.stream<event> => {
    let ins = O.fromCallback(emit => {
      let cb = (_ctx: Sdk.eventCtx, row: t) => emit(Inserted({row: row}))
      handle->onInsert(cb)
      () => handle->removeOnInsert(cb)
    })
    let upd = O.fromCallback(emit => {
      let cb = (_ctx: Sdk.eventCtx, prev: t, next: t) => emit(Updated({prev: prev, next: next}))
      handle->onUpdate(cb)
      () => handle->removeOnUpdate(cb)
    })
    let del = O.fromCallback(emit => {
      let cb = (_ctx: Sdk.eventCtx, row: t) => emit(Deleted({row: row}))
      handle->onDelete(cb)
      () => handle->removeOnDelete(cb)
    })
    O.merge([ins, upd, del])
  }

  let observeWithCtx = (handle: handle): O.stream<(Sdk.eventCtx, event)> => {
    let ins = O.fromCallback(emit => {
      let cb = (ctx: Sdk.eventCtx, row: t) => emit((ctx, Inserted({row: row})))
      handle->onInsert(cb)
      () => handle->removeOnInsert(cb)
    })
    let upd = O.fromCallback(emit => {
      let cb = (ctx: Sdk.eventCtx, prev: t, next: t) => emit((ctx, Updated({prev: prev, next: next})))
      handle->onUpdate(cb)
      () => handle->removeOnUpdate(cb)
    })
    let del = O.fromCallback(emit => {
      let cb = (ctx: Sdk.eventCtx, row: t) => emit((ctx, Deleted({row: row})))
      handle->onDelete(cb)
      () => handle->removeOnDelete(cb)
    })
    O.merge([ins, upd, del])
  }
}


// ── Display projection ────────────────────────────────────────────────────────
type display = {
  identity: string,
  playerId: bigint,
  name: string,
}

let toDisplay = (row: t): display => {
  identity: row.identity->Display.identity,
  playerId: row.playerId,
  name: row.name,
}


