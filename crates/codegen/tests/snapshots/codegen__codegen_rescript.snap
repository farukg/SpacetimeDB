// THIS FILE IS AUTOMATICALLY GENERATED. EDITS TO THIS FILE
// WILL NOT BE SAVED. MODIFY THE SOURCE CONFIGURATION INSTEAD.


// Server-side reducer wrappers — module functor with typed, async reducers.
//
// Usage:
//   module ServerReducers = StdbServerReducers.Make({
//     let getConnection = () => ServerConn.getConnection()
//   })
//   let result = await ServerReducers.serverReducers.addPlayer({name: "Alice"})

module Sdk = Stdb__Sdk
module Reducers = Stdb__Reducers

module type Config = {
  let getConnection: unit => promise<Sdk.connection>
}

module Make = (C: Config) => {

  let add = async (args: Reducers.Add.args) => {
    let conn = await C.getConnection()
    await conn->Sdk.getReducers->Reducers.Add.call_(args)
  }


  let addPlayer = async (args: Reducers.AddPlayer.args) => {
    let conn = await C.getConnection()
    await conn->Sdk.getReducers->Reducers.AddPlayer.call_(args)
  }


  let addPrivate = async (args: Reducers.AddPrivate.args) => {
    let conn = await C.getConnection()
    await conn->Sdk.getReducers->Reducers.AddPrivate.call_(args)
  }


  let assertCallerIdentityIsModuleIdentity = async () => {
    let conn = await C.getConnection()
    await conn->Sdk.getReducers->Reducers.AssertCallerIdentityIsModuleIdentity.call_
  }


  let deletePlayer = async (args: Reducers.DeletePlayer.args) => {
    let conn = await C.getConnection()
    await conn->Sdk.getReducers->Reducers.DeletePlayer.call_(args)
  }


  let deletePlayersByName = async (args: Reducers.DeletePlayersByName.args) => {
    let conn = await C.getConnection()
    await conn->Sdk.getReducers->Reducers.DeletePlayersByName.call_(args)
  }


  let listOverAge = async (args: Reducers.ListOverAge.args) => {
    let conn = await C.getConnection()
    await conn->Sdk.getReducers->Reducers.ListOverAge.call_(args)
  }


  let logModuleIdentity = async () => {
    let conn = await C.getConnection()
    await conn->Sdk.getReducers->Reducers.LogModuleIdentity.call_
  }


  let queryPrivate = async () => {
    let conn = await C.getConnection()
    await conn->Sdk.getReducers->Reducers.QueryPrivate.call_
  }


  let sayHello = async () => {
    let conn = await C.getConnection()
    await conn->Sdk.getReducers->Reducers.SayHello.call_
  }


  let test = async (args: Reducers.Test.args) => {
    let conn = await C.getConnection()
    await conn->Sdk.getReducers->Reducers.Test.call_(args)
  }


  let testBtreeIndexArgs = async () => {
    let conn = await C.getConnection()
    await conn->Sdk.getReducers->Reducers.TestBtreeIndexArgs.call_
  }



  type serverReducers = {
    add: Reducers.Add.args => promise<unit>,

    addPlayer: Reducers.AddPlayer.args => promise<unit>,

    addPrivate: Reducers.AddPrivate.args => promise<unit>,

    assertCallerIdentityIsModuleIdentity: unit => promise<unit>,

    deletePlayer: Reducers.DeletePlayer.args => promise<unit>,

    deletePlayersByName: Reducers.DeletePlayersByName.args => promise<unit>,

    listOverAge: Reducers.ListOverAge.args => promise<unit>,

    logModuleIdentity: unit => promise<unit>,

    queryPrivate: unit => promise<unit>,

    sayHello: unit => promise<unit>,

    test: Reducers.Test.args => promise<unit>,

    testBtreeIndexArgs: unit => promise<unit>,

  }

  let serverReducers: serverReducers = {
    add: add,
    addPlayer: addPlayer,
    addPrivate: addPrivate,
    assertCallerIdentityIsModuleIdentity: assertCallerIdentityIsModuleIdentity,
    deletePlayer: deletePlayer,
    deletePlayersByName: deletePlayersByName,
    listOverAge: listOverAge,
    logModuleIdentity: logModuleIdentity,
    queryPrivate: queryPrivate,
    sayHello: sayHello,
    test: test,
    testBtreeIndexArgs: testBtreeIndexArgs,
  }
}
