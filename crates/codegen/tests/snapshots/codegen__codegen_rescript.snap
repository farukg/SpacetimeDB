"Stdb__Display.res" = '''
// THIS FILE IS AUTOMATICALLY GENERATED. EDITS TO THIS FILE
// WILL NOT BE SAVED. MODIFY THE SOURCE CONFIGURATION INSTEAD.

module Types = Stdb__Types
module Sdk = Stdb__Sdk
open Sdk

// ── SDK type helpers ─────────────────────────────────────────────────

let identity = identityToHex
let connectionId = connectionIdToHex
let timestamp = timestampToFloatMs
let amount = BigInt.toFloat

// ── SDK constructors (for phantom rows / test data) ──────────────────

let emptyIdentity: identity = Identity.fromString(String.repeat("0", 64))

@new @module("spacetimedb")
external timestampFromMicros: bigint => Sdk.timestamp = "Timestamp"

let timestampFromMs = (ms: float): Sdk.timestamp =>
  timestampFromMicros(BigInt.fromInt(Float.toInt(ms)) * 1000n)

// ── Newtype unwrappers ───────────────────────────────────────────────

let baz = (v: Types.Baz.t) => v.field
let privateTable = (v: Types.PrivateTable.t) => v.name
let removeTable = (v: Types.RemoveTable.t) => v.id
let testB = (v: Types.TestB.t) => v.foo
let testD = (v: Types.TestD.t) => v.testC
let testFoobar = (v: Types.TestFoobar.t) => v.field

// ── Enum toString ────────────────────────────────────────────────────

let namespaceTestCToString = (v: Types.NamespaceTestC.t) =>
  switch v {
  | Types.NamespaceTestC.Foo => "Foo"

  | Types.NamespaceTestC.Bar => "Bar"

  }

// ── Enum fromString ─────────────────────────────────────────────────

let namespaceTestCFromString = (v: string): option<Types.NamespaceTestC.t> =>
  switch v {
  | "Foo" => Some(Types.NamespaceTestC.Foo)

  | "Bar" => Some(Types.NamespaceTestC.Bar)

  | _ => None
  }

// ── Sum enum toString ───────────────────────────────────────────────

let foobarToString = (v: Types.Foobar.t) =>
  switch v {
  | Types.Foobar.Baz(payload) => "Baz(" ++ JSON.stringifyAny(payload)->Option.getOr("<opaque>") ++ ")"

  | Types.Foobar.Bar => "Bar"

  | Types.Foobar.Har(payload) => "Har(" ++ Int.toString(payload) ++ ")"

  }
let namespaceTestFToString = (v: Types.NamespaceTestF.t) =>
  switch v {
  | Types.NamespaceTestF.Foo => "Foo"

  | Types.NamespaceTestF.Bar => "Bar"

  | Types.NamespaceTestF.Baz(payload) => "Baz(" ++ payload ++ ")"

  }

