"Stdb__Async.res" = '''
// GENERATED — DO NOT EDIT
// Module type contracts for observer/functor mode.
// Implement these once in your app; all reducer and table functors accept them.

// EFFECT_RUNTIME — for reducer calls.
// E.effect<'a> is your effect/stream type.
// fromPromise converts the SDK's promise boundary into your effect type (thunked).
// toPromise is the inverse — for interop with promise-based APIs.
// run executes as fire-and-forget without exposing promise.
module type EFFECT_RUNTIME = {
  type effect<'a>
  let fromPromise: (unit => promise<'a>) => effect<'a>
  let toPromise: effect<'a> => promise<'a>
  let run: effect<'a> => unit
}

// OBSERVER — for table subscriptions.
// O.stream<'a> is your stream type.
// fromCallback receives: emit => cleanup. Cleanup is strict (always callable, may be no-op).
// merge combines N streams of same type.
module type OBSERVER = {
  type stream<'a>
  let fromCallback: (('a => unit) => unit => unit) => stream<'a>
  let merge: array<stream<'a>> => stream<'a>
}
'''
"Stdb__Client.res" = '''
// THIS FILE IS AUTOMATICALLY GENERATED BY SPACETIMEDB. EDITS TO THIS FILE
// WILL NOT BE SAVED. MODIFY TABLES IN YOUR MODULE SOURCE CODE INSTEAD.

// Opaque SDK types — hold JS class instances from the SpacetimeDB SDK




// DB record — @as maps camelCase fields to snake_case runtime keys
type db = {
  @as("logged_out_player") loggedOutPlayer: Stdb__Tables__LoggedOutPlayer.handle,
  @as("person") person: Stdb__Tables__Person.handle,
  @as("player") player: Stdb__Tables__Player.handle,
  @as("test_d") testD: Stdb__Tables__TestD.handle,
  @as("test_f") testF: Stdb__Tables__TestF.handle,
  @as("my_player") myPlayer: Stdb__Tables__MyPlayer.handle,
}

// DB and reducers access from connection
@get external db: Stdb__Sdk.connection => db = "db"
@get external reducers: Stdb__Sdk.connection => Stdb__Sdk.reducers = "reducers"'''
"Stdb__Display.res" = '''
// THIS FILE IS AUTOMATICALLY GENERATED BY SPACETIMEDB. EDITS TO THIS FILE
// WILL NOT BE SAVED. MODIFY TABLES IN YOUR MODULE SOURCE CODE INSTEAD.
open StdbTypes
open Stdb__Sdk

// ── SDK type helpers ─────────────────────────────────────────────────

let identity = identityToHex
let connectionId = connectionIdToHex
let timestamp = timestampToFloatMs
let amount = BigInt.toFloat

// ── Newtype unwrappers ───────────────────────────────────────────────

let baz = (v: Baz.t) => v.field
let privateTable = (v: PrivateTable.t) => v.name
let removeTable = (v: RemoveTable.t) => v.id
let testB = (v: TestB.t) => v.foo
let testD = (v: TestD.t) => v.testC
let testFoobar = (v: TestFoobar.t) => v.field

// ── Enum toString ────────────────────────────────────────────────────

let namespaceTestCToString = (v: NamespaceTestC.t) =>
  switch v {
  | Foo => "Foo"

  | Bar => "Bar"

  }


// ── Enum fromString ─────────────────────────────────────────────────

let namespaceTestCFromString = (v: string): option<NamespaceTestC.t> =>
  switch v {
  | "Foo" => Some(Foo)
  | "Bar" => Some(Bar)
  | _ => None
  }
'''
