// THIS FILE IS AUTOMATICALLY GENERATED BY SPACETIMEDB. EDITS TO THIS FILE
// WILL NOT BE SAVED. MODIFY TABLES IN YOUR MODULE SOURCE CODE INSTEAD.

// Server-side reducer wrappers — module functor with typed, async reducers.
//
// Usage:
//   module ServerReducers = StdbServerReducers.Make({
//     let getConnection = () => ServerConn.getConnection()
//   })
//   let result = await ServerReducers.serverReducers.addPlayer({name: "Alice"})

open StdbSdk

module type Config = {
  let getConnection: unit => promise<connection>
}

module Make = (C: Config) => {
  @val external setTimeout: (unit => unit, int) => float = "setTimeout"

  @val @scope(("process", "env"))
  external syncDelayMsEnv: option<string> = "STDB_TYPED_REDUCER_SYNC_DELAY_MS"

  let syncDelayMs = switch syncDelayMsEnv {
  | Some(s) => Int.fromString(s)->Option.getOr(300)
  | None => 300
  }

  let sleep = (ms) => {
    Promise.make((resolve, _reject) => {
      let _ = setTimeout(() => resolve(), ms)
    })
  }

  let add = async (args: StdbAddReducer.args) => {
    let conn = await C.getConnection()
    let result = await conn->StdbClient.reducers->StdbAddReducer.add(args)
    if syncDelayMs > 0 { await sleep(syncDelayMs) }
    result
  }

  let addPlayer = async (args: StdbAddPlayerReducer.args) => {
    let conn = await C.getConnection()
    let result = await conn->StdbClient.reducers->StdbAddPlayerReducer.addPlayer(args)
    if syncDelayMs > 0 { await sleep(syncDelayMs) }
    result
  }

  let addPrivate = async (args: StdbAddPrivateReducer.args) => {
    let conn = await C.getConnection()
    let result = await conn->StdbClient.reducers->StdbAddPrivateReducer.addPrivate(args)
    if syncDelayMs > 0 { await sleep(syncDelayMs) }
    result
  }

  let assertCallerIdentityIsModuleIdentity = async () => {
    let conn = await C.getConnection()
    let result = await conn->StdbClient.reducers->StdbAssertCallerIdentityIsModuleIdentityReducer.assertCallerIdentityIsModuleIdentity
    if syncDelayMs > 0 { await sleep(syncDelayMs) }
    result
  }

  let deletePlayer = async (args: StdbDeletePlayerReducer.args) => {
    let conn = await C.getConnection()
    let result = await conn->StdbClient.reducers->StdbDeletePlayerReducer.deletePlayer(args)
    if syncDelayMs > 0 { await sleep(syncDelayMs) }
    result
  }

  let deletePlayersByName = async (args: StdbDeletePlayersByNameReducer.args) => {
    let conn = await C.getConnection()
    let result = await conn->StdbClient.reducers->StdbDeletePlayersByNameReducer.deletePlayersByName(args)
    if syncDelayMs > 0 { await sleep(syncDelayMs) }
    result
  }

  let listOverAge = async (args: StdbListOverAgeReducer.args) => {
    let conn = await C.getConnection()
    let result = await conn->StdbClient.reducers->StdbListOverAgeReducer.listOverAge(args)
    if syncDelayMs > 0 { await sleep(syncDelayMs) }
    result
  }

  let logModuleIdentity = async () => {
    let conn = await C.getConnection()
    let result = await conn->StdbClient.reducers->StdbLogModuleIdentityReducer.logModuleIdentity
    if syncDelayMs > 0 { await sleep(syncDelayMs) }
    result
  }

  let queryPrivate = async () => {
    let conn = await C.getConnection()
    let result = await conn->StdbClient.reducers->StdbQueryPrivateReducer.queryPrivate
    if syncDelayMs > 0 { await sleep(syncDelayMs) }
    result
  }

  let sayHello = async () => {
    let conn = await C.getConnection()
    let result = await conn->StdbClient.reducers->StdbSayHelloReducer.sayHello
    if syncDelayMs > 0 { await sleep(syncDelayMs) }
    result
  }

  let test = async (args: StdbTestReducer.args) => {
    let conn = await C.getConnection()
    let result = await conn->StdbClient.reducers->StdbTestReducer.test(args)
    if syncDelayMs > 0 { await sleep(syncDelayMs) }
    result
  }

  let testBtreeIndexArgs = async () => {
    let conn = await C.getConnection()
    let result = await conn->StdbClient.reducers->StdbTestBtreeIndexArgsReducer.testBtreeIndexArgs
    if syncDelayMs > 0 { await sleep(syncDelayMs) }
    result
  }


  type serverReducers = {
    add: StdbAddReducer.args => promise<unit>,

    addPlayer: StdbAddPlayerReducer.args => promise<unit>,

    addPrivate: StdbAddPrivateReducer.args => promise<unit>,

    assertCallerIdentityIsModuleIdentity: unit => promise<unit>,

    deletePlayer: StdbDeletePlayerReducer.args => promise<unit>,

    deletePlayersByName: StdbDeletePlayersByNameReducer.args => promise<unit>,

    listOverAge: StdbListOverAgeReducer.args => promise<unit>,

    logModuleIdentity: unit => promise<unit>,

    queryPrivate: unit => promise<unit>,

    sayHello: unit => promise<unit>,

    test: StdbTestReducer.args => promise<unit>,

    testBtreeIndexArgs: unit => promise<unit>,

  }

  let serverReducers: serverReducers = {
    add: add,
    addPlayer: addPlayer,
    addPrivate: addPrivate,
    assertCallerIdentityIsModuleIdentity: assertCallerIdentityIsModuleIdentity,
    deletePlayer: deletePlayer,
    deletePlayersByName: deletePlayersByName,
    listOverAge: listOverAge,
    logModuleIdentity: logModuleIdentity,
    queryPrivate: queryPrivate,
    sayHello: sayHello,
    test: test,
    testBtreeIndexArgs: testBtreeIndexArgs,
  }
}
