module MakeStream = (O: Stdb__Async.OBSERVER) => {
  let observe = (handle: handle): O.stream<event> => {
    let ins = O.fromCallback(emit => {
      let cb = (_ctx: Stdb__Sdk.eventCtx, row: t) => emit(Inserted({row: row}))
      handle->onInsert(cb)
      () => handle->removeOnInsert(cb)
    })
    let upd = O.fromCallback(emit => {
      let cb = (_ctx: Stdb__Sdk.eventCtx, prev: t, next: t) => emit(Updated({prev: prev, next: next}))
      handle->onUpdate(cb)
      () => handle->removeOnUpdate(cb)
    })
    let del = O.fromCallback(emit => {
      let cb = (_ctx: Stdb__Sdk.eventCtx, row: t) => emit(Deleted({row: row}))
      handle->onDelete(cb)
      () => handle->removeOnDelete(cb)
    })
    O.merge([ins, upd, del])
  }

  let observeWithCtx = (handle: handle): O.stream<(Stdb__Sdk.eventCtx, event)> => {
    let ins = O.fromCallback(emit => {
      let cb = (ctx: Stdb__Sdk.eventCtx, row: t) => emit((ctx, Inserted({row: row})))
      handle->onInsert(cb)
      () => handle->removeOnInsert(cb)
    })
    let upd = O.fromCallback(emit => {
      let cb = (ctx: Stdb__Sdk.eventCtx, prev: t, next: t) => emit((ctx, Updated({prev: prev, next: next})))
      handle->onUpdate(cb)
      () => handle->removeOnUpdate(cb)
    })
    let del = O.fromCallback(emit => {
      let cb = (ctx: Stdb__Sdk.eventCtx, row: t) => emit((ctx, Deleted({row: row})))
      handle->onDelete(cb)
      () => handle->removeOnDelete(cb)
    })
    O.merge([ins, upd, del])
  }
}


// React hook — typed query binding
@module("../StdbSchema.res.mjs") @scope("tables") @val
external query: Stdb__React.query<t> = "test_f"

let useRows = () => Stdb__React.useTable(query)
let useRowsState = () => Stdb__React.useTableState(query)
let useRowsWith = (~onInsert=?, ~onUpdate=?, ~onDelete=?) =>
  Stdb__React.useTableWith(query, {?onInsert, ?onDelete, ?onUpdate})
let useDisplayRows = () => Stdb__React.useTable(query)->Array.map(toDisplay)


// ── Display projection ────────────────────────────────────────────────────────
type display = {
  field: Stdb__Types.Foobar.t,
}

let toDisplay = (row: t): display => {
  field: row.field,
}

'''
