  let observe: (call<'a>, ~onValue: 'a => unit, ~onError: error => unit) => cleanup
  let map: (call<'a>, 'a => 'b) => call<'b>
  let flatMap: (call<'a>, 'a => call<'b>) => call<'b>
  let capture: call<'a> => call<result<'a, error>>
  let describeError: error => string
