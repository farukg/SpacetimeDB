let toKey = (v: t): string => v.name
let equal = (a: t, b: t): bool => a.name === b.name
}

module RemoveTable = {
type t = {
  @as("id") id: int,

}
let make = (v: int): t => { id: v }
let value = (v: t): int => v.id
let toKey = (v: t): string => Int.toString(v.id)
let equal = (a: t, b: t): bool => a.id === b.id
}

